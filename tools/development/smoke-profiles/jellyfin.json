{
  "app": "jellyfin",
  "gitRepository": "branch-jellyfin-${branch_slug}",
  "activationTemplate": "kubernetes/clusters/development/branches/jellyfin-template.yaml",
  "namespace": "jellyfin-${branch_slug}",
  "routeUrls": [
    "https://jellyfin-${branch_slug}.dev.lab.petebeegle.com"
  ],
  "checks": {
    "kustomizations": [
      "branch-jellyfin-${branch_slug}"
    ],
    "helmReleases": [
      "jellyfin-${branch_slug}"
    ],
    "pvcs": [
      {
        "name": "jellyfin-config-local-v1-${branch_slug}",
        "storageClass": "local-path"
      }
    ],
    "services": [
      "jellyfin",
      "jellyfin-metrics-deny-${branch_slug}"
    ],
    "httpRoutes": [
      "jellyfin-${branch_slug}"
    ],
    "httpProbes": [
      {
        "service": "jellyfin",
        "port": 8096,
        "path": "/",
        "bodyRegex": "Jellyfin|Please sign in|Wizard|Login"
      },
      {
        "service": "jellyfin",
        "port": 8096,
        "path": "/Branding/Configuration",
        "bodyRegex": "sso/OID/start/authentik"
      }
    ]
  },
  "prSmoke": true
}
