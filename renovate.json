{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 10,
  "dependencyDashboard": true,
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "extends": [
    "config:recommended",
    "group:kubernetesMonorepo",
    ":enablePreCommit",
    ":pinVersions"
  ],
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(?:^|/)gotk-components\\.ya?ml$/",
      "/(?:^|/)kubernetes(?:/.+)?/repository\\.ya?ml$/",
      "/(?:^|/)kubernetes(?:/.+)?/release\\.ya?ml$/",
      "/(?:^|/)kubernetes(?:/.+)?/app\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(?:^|/)kubernetes(?:/.+)?/*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(?:^|/)kubernetes/infra/crds/kustomization\\.ya?ml$/",
        "/(?:^|/)terraform/modules/talos-bootstrap/templates/control_plane.yaml.tftpl$/"
      ],
      "matchStrings": [
        "https://github.com/(?<depName>[^/]+/[^/]+)//[^?]+\\?ref=(?<currentValue>.*?)\\s",
        "https://raw.githubusercontent.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(?:^|/)terraform/production/terraform.tfvars$/"
      ],
      "matchStrings": [
        "talos_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(?:^|/)terraform/modules/talos-bootstrap/network.tf$/"
      ],
      "matchStrings": [
        "chart\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io/",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflows and composite actions, marked with a `# renovate:` comment on the line above",
      "managerFilePatterns": [
        "/(?:^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(?:^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*[A-Za-z_]+:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "terraform": {
    "managerFilePatterns": [
      "/\\.tf$/"
    ]
  },
  "packageRules": [
    {
      "groupName": "fluxcd",
      "matchFileNames": [
        "kubernetes/clusters/**/flux-system/gotk-components.yaml",
        "kubernetes/clusters/**/flux-system/gotk-components.yml"
      ],
      "matchPackageNames": [
        "fluxcd/flux2",
        "ghcr.io/fluxcd/**",
        "docker.io/fluxcd/**"
      ]
    },
    {
      "groupName": "cilium",
      "matchPackageNames": [
        "cilium"
      ],
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "description": "Playwright's runner image and npm package must be the same version (tools/renovate/tests/test_renovate_config.py, tools/development/tests/test_runner_image.py); update every copy in one PR",
      "groupName": "playwright",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "playwright-core",
        "mcr.microsoft.com/playwright"
      ]
    },
    {
      "description": "Regenerate Terraform docs after Terraform dependency updates",
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "terraform/**"
      ],
      "postUpgradeTasks": {
        "commands": [
          "./tools/renovate/update-terraform-docs.sh"
        ],
        "fileFilters": [
          "terraform/**/README.md"
        ],
        "executionMode": "update"
      }
    },
    {
      "description": "Auto-merge only what dev-smoke deploys and tests in development: the smoke-tested apps and the infrastructure development runs. Every file these paths match must be deployed by development (tools/renovate/tests/test_renovate_automerge.py). Renovate merges once every check is green, dev-smoke included (platformAutomerge is off); major updates stay manual.",
      "matchFileNames": [
        "kubernetes/apps/dev-runner/**",
        "kubernetes/apps/home-assistant/base/**",
        "kubernetes/apps/home-assistant/branch/**",
        "kubernetes/apps/homepage/base/**",
        "kubernetes/apps/homepage/branch/**",
        "kubernetes/apps/homepage/development/**",
        "kubernetes/apps/immich/base/**",
        "kubernetes/apps/immich/branch/**",
        "kubernetes/apps/jellyfin/base/**",
        "kubernetes/apps/jellyfin/branch/**",
        "kubernetes/apps/nexus/branch/**",
        "kubernetes/apps/whoami/**",
        "kubernetes/infra/controllers/cert-manager/**",
        "kubernetes/infra/controllers/cert-manager-development/**",
        "kubernetes/infra/controllers/cloudnative-pg/**",
        "kubernetes/infra/controllers/intel-device-plugins/gpu/**",
        "kubernetes/infra/controllers/intel-device-plugins/operator/**",
        "kubernetes/infra/controllers/local-path-provisioner/**",
        "kubernetes/infra/controllers/metrics-server/**",
        "kubernetes/infra/controllers/nfs-csi/**",
        "kubernetes/infra/controllers/onepassword-operator/**",
        "kubernetes/infra/crds/**",
        "kubernetes/infra/network/certs/**",
        "kubernetes/infra/network/certs-development/**",
        "kubernetes/infra/network/cilium/**",
        "kubernetes/infra/network/gateway/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "rebaseWhen": "conflicted"
    }
  ]
}
