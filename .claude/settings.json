{
  "model": "sonnet",
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "WebSearch(*)",
      "WebFetch(*)",
      "Grep(*)",
      "Glop(*)",
      "Read(*)",
      "mcp__*",
      "Bash(flux check:*)",
      "Bash(flux get:*)",
      "Bash(flux logs:*)",
      "Bash(flux debug:*)",
      "Bash(cilium status:*)",
      "Bash(cilium connectivity:*)",
      "Bash(pre-commit *)",
      "Bash(talosctl version:*)",
      "Bash(talosctl -n:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform output:*)",
      "mcp__context7__*",
      "mcp__kubernetes__*"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '\"$CLAUDE_PROJECT_DIR/.codex/hooks/terraform_plan.sh\" || exit 2'",
            "statusMessage": "Checking Terraform apply safety",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash -c 'jq -r .tool_input.command | grep -qE \"git (commit|push)\" || exit 0; \"$CLAUDE_PROJECT_DIR/.codex/hooks/sops_guard.sh\" || exit 2'",
            "statusMessage": "Checking for unencrypted secrets"
          }
        ]
      }
    ]
  }
}
